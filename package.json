{
  "name": "moneymap",
  "version": "1.0.0",
  "private": true,
  "description": "Controle financeiro com dashboard, metas, categorias e personalização",
  "scripts": {
    "dev": "npx serve .",
    "deploy": "npx vercel --prod",
    "app": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "main": "desktop/main.js",
  "author": "ZoxCode",
  "homepage": "https://github.com/zoxcode",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zoxcode.moneymap",
    "productName": "MoneyMap",
    "copyright": "ZoxCode",
    "directories": {
      "output": "instalador",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "*.png",
      "favicon.ico",
      "desktop/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MoneyMap",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MoneyMap-Instalador-${version}.${ext}"
    }
  }
}